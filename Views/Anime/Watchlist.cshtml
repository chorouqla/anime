@{
    ViewData["Title"] = "My Watchlist";
}

<!DOCTYPE html>
<html>

<head>
    <title>My Anime Watchlist</title>
    <style>
            body {
                font-family: Arial, sans-serif;
                padding: 20px;
                background-color: #f5f5f5;
            }

            .container {
                max-width: 1200px;
                margin: 0 auto;
            }

            h1 {
                text-align: center;
                color: #333;
            }

            .watchlist-grid {
                display: flex;
                flex-wrap: wrap;
                gap: 20px;
                justify-content: center;
                margin-top: 30px;
            }

            .watchlist-card {
                width: 200px;
                background: white;
                border-radius: 10px;
                padding: 15px;
                text-align: center;
                box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            }

            .watchlist-card h3 {
                font-size: 16px;
                margin: 10px 0;
            }

            .remove-btn {
                background-color: #dc3545;
                color: white;
                border: none;
                padding: 8px 15px;
                border-radius: 5px;
                cursor: pointer;
                margin-top: 10px;
            }

            .remove-btn:hover {
                background-color: #c82333;
            }

            .empty-msg {
                text-align: center;
                padding: 50px;
                background: white;
                border-radius: 10px;
                margin-top: 30px;
            }

            .empty-msg a {
                color: #007bff;
                text-decoration: none;
            }

            .back-link {
                display: block;
                text-align: center;
                margin-top: 30px;
                color: #007bff;
                text-decoration: none;
                font-size: 16px;
            }

            .back-link:hover {
                text-decoration: underline;
            }
    </style>
</head>

<body>
    <div class="container">
        <h1>📋 My Anime Watchlist</h1>
        
        <div id="watchlistContainer" class="watchlist-grid"></div>
        
        <a href="/Anime" class="back-link">← Back to explore anime</a>
    </div>
    
    <script>
            function loadWatchlist() {
                let watchlist = JSON.parse(localStorage.getItem('animeWatchlist') || '[]');
                let container = document.getElementById('watchlistContainer');
            
                if (watchlist.length === 0) {
                    container.innerHTML = '<div class="empty-msg"><p>✨ Your watchlist is empty.</p><p>Go to <a href="/Anime">Anime Explorer</a> to add some anime!</p></div>';
                    return;
                }
            
                container.innerHTML = '';
                watchlist.forEach(anime => {
                    container.innerHTML += `
                        <div class="watchlist-card">
                            <a href="/Anime/Details?id=${anime.id}" style="text-decoration: none; color: #333;">
                                <h3>${anime.title}</h3>
                            </a>
                            <button onclick="removeFromWatchlist(${anime.id})" class="remove-btn">
                                ❌ Remove
                            </button>
                        </div>
                    `;
                });
            }
        
            function removeFromWatchlist(id) {
                let watchlist = JSON.parse(localStorage.getItem('animeWatchlist') || '[]');
                watchlist = watchlist.filter(anime => anime.id !== id);
                localStorage.setItem('animeWatchlist', JSON.stringify(watchlist));
                loadWatchlist(); // Refresh the page
            }
        
            // Load watchlist when page opens
            loadWatchlist();
    </script>
</body>

</html>